{
  "name": "agent-benchmarks",
  "version": "0.1.0",
  "private": true,
  "description": "Private research app for benchmarking models, harnesses, and agentic workflows from local agent session logs.",
  "license": "Apache-2.0",
  "packageManager": "bun@1.4.4",
  "type": "module",
  "bin": {
    "agent-benchmarks": "./src/cli.ts"
