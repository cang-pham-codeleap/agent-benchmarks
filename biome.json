{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "src/**",
      "test/**",
      "scripts/**",
      "*.json",
      "!test/golden",
      "!src/report/fonts/Source-Serif-OFL.md"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noLabelWithoutControl": {
          "level": "error",
          "options": {
            "inputComponents": ["Input", "Checkbox", "SelectTrigger"]
          }
        }
      },
      "style": {
        "noDescendingSpecificity": "off"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/**", "!src/cli.ts", "!src/cli/**", "!src/ui/**", "!src/logging.ts"],
      "plugins": ["./lint/no-console-in-core.grit"]
    }
  ]
}
